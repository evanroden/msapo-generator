# Public, synthetic TEMPLATE ONLY. Maintain separate approved values per environment.
# No real destination or secret values in source control; no live submission.
SMARTSHEET_API_MODE=disabled
SMARTSHEET_ALLOW_CUSTOM_API_BASE=false
SMARTSHEET_API_BASE_URL=https://api.smartsheet.com/2.0
# Keep manual/prefill blocked until the environment's exact form and labels are approved.
SMARTSHEET_FORM_URL=
SMARTSHEET_URL_PREFILL_ENABLED=false
SMARTSHEET_FORM_FIELD_MAP_JSON={}
SMARTSHEET_FORM_VALUE_MAP_JSON={}
SMARTSHEET_FORM_ORDER=request_type,requester_name,job_number,site_location,cost_code,object_account,agreement_type,original_po_number,total,vendor,contact_name,contact_email,description_of_work,asset_id,dispatch_service_center,instructions
SMARTSHEET_FORM_REQUIRED_FIELDS=request_type,requester_name,job_number,site_location,cost_code,object_account,agreement_type,total,vendor,contact_name,contact_email,description_of_work,dispatch_service_center
SMARTSHEET_PREFILL_MAX_URL_LENGTH=7000
SMARTSHEET_ROW_POSITION=bottom
# No real SMARTSHEET_API_TOKEN, SHEET_ID or COLUMN_SPECS in normal migration.
EXPENSE_ACCOUNT_DIRECTORS_JSON={"Synthetic Account":{"name":"Test Director","email":"director@example.invalid"}}
PDF_BACKEND=libreoffice
EPC_DATA_DIR=/test1
# Optional AI settings are governed by the separate ENFRA provider approval.
# Do not enable Gotenberg, Microsoft Graph, SMTP or JDE submission.
