# ── Host/runtime ─────────────────────────────────────────────────────
# PORT is honored by most PaaS hosts; EPC_PORT is the app-specific fallback.
# PORT=8501
# EPC_HOST=0.0.0.0
# EPC_TEMPLATE_PATH=./templates/Master_MSAPO_Template.docx
# EPC_WORK_DIR=/tmp/email-process-control
# EPC_OUTPUT_DIR=/tmp/email-process-control/output
# Set this to a durable mounted path in production when learning or live
# Smartsheet idempotency must survive restarts.
# EPC_DATA_DIR=./data_store
# EPC_REQUESTER_NAME=Evan Roden

# ── AI provider ──────────────────────────────────────────────────────
EPC_AI_PROVIDER=anthropic
EPC_AI_API_KEY=replace-me
EPC_AI_MODEL=claude-sonnet-4-6
EPC_AI_MAX_RETRIES=3
EPC_AI_RETRY_BASE_SECONDS=5
EPC_AI_MAX_INPUT_CHARS=250000

# Backward-compatible current deployment names are still accepted:
# ANTHROPIC_API_KEY=...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI Chat Completions-compatible enterprise gateway:
# EPC_AI_PROVIDER=openai_chat_compatible
# EPC_AI_ENDPOINT=https://approved-ai.example/v1/chat/completions
# EPC_AI_AUTH_HEADER=Authorization
# EPC_AI_AUTH_PREFIX=Bearer 

# Trusted custom adapter factory: package.module:factory
# EPC_AI_PROVIDER=custom
# EPC_AI_ADAPTER=company_epc.ai:create_provider

# ── PDF reading/OCR ──────────────────────────────────────────────────
EPC_PDF_READER=pymupdf
# EPC_PDF_READER=custom
# EPC_PDF_READER_ADAPTER=company_epc.pdf:create_reader
EPC_PDF_TEXT_MIN_CHARS=20
EPC_OCR_MAX_PAGES=30
EPC_OCR_DPI=150
EPC_OCR_PAGES_PER_BATCH=5
EPC_OCR_MAX_PIXELS_PER_PAGE=40000000
EPC_OCR_MAX_TOTAL_IMAGE_BYTES=52428800

# ── DOCX-to-PDF conversion ───────────────────────────────────────────
EPC_PDF_CONVERTER=libreoffice
# EPC_PDF_CONVERTER=gotenberg
# GOTENBERG_URL=http://gotenberg:3000
# EPC_ALLOW_INSECURE_CONVERTER=false
# EPC_PDF_CONVERTER=docx2pdf
# EPC_PDF_CONVERTER=none
# EPC_PDF_CONVERTER=custom
# EPC_PDF_CONVERTER_ADAPTER=company_epc.pdf:create_converter

# ── Persistence ──────────────────────────────────────────────────────
EPC_MEMORY_BACKEND=sqlite
# EPC_MEMORY_BACKEND=disabled
# EPC_MEMORY_BACKEND=custom
# EPC_MEMORY_ADAPTER=company_epc.storage:create_memory
EPC_SUBMISSION_STORE_BACKEND=sqlite
# EPC_SUBMISSION_STORE_BACKEND=custom
# EPC_SUBMISSION_STORE_ADAPTER=company_epc.storage:create_submission_store

# ── Future Smartsheet PO handoff — all routes are off by default ─────
# SMARTSHEET_FORM_URL=https://app.smartsheet.com/b/form/FINAL_FORM_ID
# SMARTSHEET_FORM_ORDER=requester_name,contract,site,vendor,description,total
# SMARTSHEET_FORM_REQUIRED_FIELDS=requester_name,site,billing_method,scope_of_work,total
SMARTSHEET_URL_PREFILL_ENABLED=false
SMARTSHEET_PREFILL_MAX_URL_LENGTH=7000
# SMARTSHEET_FORM_FIELD_MAP_JSON={"site":"Exact Site Field Label","total":"Exact Amount Field Label"}
# SMARTSHEET_FORM_VALUE_MAP_JSON={"related_to_om":{"Yes":"Yes","No":"No"}}
SMARTSHEET_API_MODE=disabled
# SMARTSHEET_API_TOKEN=do-not-commit-real-token
# SMARTSHEET_SHEET_ID=1234567890123456
# SMARTSHEET_COLUMN_SPECS_JSON={"site":{"id":1111111111111111,"title":"Site","type":"TEXT_NUMBER"},"total":{"id":2222222222222222,"title":"Amount","type":"TEXT_NUMBER"},"submission_key":{"id":3333333333333333,"title":"Email Process Control Submission Key","type":"TEXT_NUMBER"}}
# SMARTSHEET_REQUIRED_FIELDS=contract,site,vendor,description,cost_code,total
# SMARTSHEET_ROW_POSITION=bottom
SMARTSHEET_ALLOW_CUSTOM_API_BASE=false
# SMARTSHEET_API_BASE_URL=https://test-server.example/2.0
