# ── Required ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-YOUR-KEY-HERE

# ── Optional ─────────────────────────────────────────────────────────
# Anthropic model override (default: claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# PDF conversion backend: libreoffice | gotenberg | docx2pdf
PDF_BACKEND=libreoffice

# Gotenberg URL (only needed if PDF_BACKEND=gotenberg)
# GOTENBERG_URL=http://localhost:3000

# Persistent per-contract learning directory (Render uses /test1)
# EPC_DATA_DIR=./data_store
