# ── Required ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=replace-with-private-key

# ── Optional core configuration ───────────────────────────────────────
# ANTHROPIC_MODEL=claude-sonnet-4-6
PDF_BACKEND=libreoffice
# Synthetic local defaults only. Configure the approved RRH administrator
# privately in the deployment environment.
RRH_APPROVER_NAME=RRH Test Administrator
RRH_APPROVER_EMAIL=rrh.approver@example.invalid
# GOTENBERG_URL=http://localhost:3000
# EPC_DATA_DIR=./data_store

# ── Smartsheet PO handoff ─────────────────────────────────────────────
# Replace this nonfunctional test ID with the private production form URL.
# Direct API writes remain independently disabled until their acceptance gates pass.
SMARTSHEET_FORM_URL=https://app.smartsheet.com/b/form/00000000000000000000000000000000
SMARTSHEET_FORM_ORDER=request_type,requester_name,job_number,site_location,cost_code,object_account,agreement_type,original_po_number,total,vendor,contact_name,contact_email,description_of_work,asset_id,dispatch_service_center,instructions
SMARTSHEET_FORM_REQUIRED_FIELDS=request_type,requester_name,job_number,site_location,cost_code,object_account,agreement_type,total,vendor,contact_name,contact_email,description_of_work,dispatch_service_center

# Logical fields map only to verified exact visible labels. REQUEST COMPLETED,
# PO #, and WORK ORDER # are omitted and always blank. ORIGINAL PO NUMBER is
# emitted only when Request Type is CHANGE ORDER.
SMARTSHEET_FORM_FIELD_MAP_JSON={"request_type":"REQUEST TYPE","requester_name":"REQUESTER","job_number":"JOB NUMBER","site_location":"SITE NUMBER / LOCATION","cost_code":"COST CODE","object_account":"OBJECT ACCOUNT","agreement_type":"AGREEMENT TYPE FOR PO","original_po_number":"ORIGINAL PO NUMBER","total":"PO/CO AMOUNT","vendor":"VENDOR NAME","contact_name":"VENDOR CONTACT NAME","contact_email":"VENDOR CONTACT EMAIL","description_of_work":"DESCRIPTION OF WORK","asset_id":"ASSET ID","dispatch_service_center":"DISPATCH WO TO SERVICE CENTER?","instructions":"ADDITIONAL INFORMATION IF NEEDED"}
SMARTSHEET_URL_PREFILL_ENABLED=true
SMARTSHEET_PREFILL_MAX_URL_LENGTH=7000
# Optional only if a deployed form uses display values different from EPC values.
# SMARTSHEET_FORM_VALUE_MAP_JSON={"request_type":{"PO":"PO"},"dispatch_service_center":{"NA":"NA"}}

# API mode: disabled | dry_run | live. Never go directly from disabled to live.
SMARTSHEET_API_MODE=disabled
# SMARTSHEET_API_TOKEN=do-not-commit-real-token
# SMARTSHEET_SHEET_ID=1234567890123456
# Exact live specifications: logical field -> ID, exact title, exact type, and
# optional expected picklist options. A dedicated submission_key column is required.
# SMARTSHEET_COLUMN_SPECS_JSON={"site_location":{"id":1111111111111111,"title":"SITE NUMBER / LOCATION","type":"TEXT_NUMBER"},"total":{"id":2222222222222222,"title":"PO/CO AMOUNT","type":"TEXT_NUMBER"},"submission_key":{"id":3333333333333333,"title":"Purchase Order Process Control Submission Key","type":"TEXT_NUMBER"}}
# SMARTSHEET_REQUIRED_FIELDS=request_type,requester_name,job_number,site_location,cost_code,object_account,agreement_type,total,vendor,contact_name,contact_email,description_of_work,dispatch_service_center
# SMARTSHEET_ROW_POSITION=bottom

# Custom API bases are for controlled non-live tests only. Live mode always
# restricts tokens to https://api.smartsheet.com/2.0.
SMARTSHEET_ALLOW_CUSTOM_API_BASE=false
# SMARTSHEET_API_BASE_URL=https://test-server.example/2.0
