# ── Required ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-YOUR-KEY-HERE

# ── Optional ─────────────────────────────────────────────────────────
# Anthropic model override (default: claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# PDF conversion backend: libreoffice | gotenberg | docx2pdf
PDF_BACKEND=libreoffice

# Gotenberg URL (only needed if PDF_BACKEND=gotenberg)
# GOTENBERG_URL=http://localhost:3000

# Persistent per-contract learning and Smartsheet idempotency directory
# Render uses /test1
# EPC_DATA_DIR=./data_store

# Default person shown on a future Smartsheet request
# EPC_REQUESTER_NAME=Evan Roden

# ── Future Smartsheet PO handoff — all routes are off by default ─────
# Manual copy/paste route: only the final form URL is required.
# SMARTSHEET_FORM_URL=https://app.smartsheet.com/b/form/FINAL_FORM_ID

# URL prefill route: enable only after testing the final form. Keys are Email
# Process Control logical fields; values are the form's exact visible labels.
SMARTSHEET_URL_PREFILL_ENABLED=false
# SMARTSHEET_FORM_FIELD_MAP_JSON={"site":"Exact Site Field Label","total":"Exact Amount Field Label"}
# SMARTSHEET_FORM_VALUE_MAP_JSON={"related_to_om":{"true":"Yes","false":"No"}}
# SMARTSHEET_FORM_ORDER=requester_name,contract,site,vendor,description,total

# API route: disabled | dry_run | live. Live mode requires a service-account
# token, destination sheet ID, explicit verified column IDs, and a confirmed
# required-field list. Never use fuzzy column-title matching in production.
SMARTSHEET_API_MODE=disabled
# SMARTSHEET_API_TOKEN=do-not-commit-real-token
# SMARTSHEET_SHEET_ID=1234567890123456
# SMARTSHEET_COLUMN_MAP_JSON={"site":1111111111111111,"total":2222222222222222,"submission_key":3333333333333333}
# SMARTSHEET_REQUIRED_FIELDS=contract,site,vendor,description,cost_code,total
# SMARTSHEET_ROW_POSITION=bottom
