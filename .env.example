# ── Required ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-YOUR-KEY-HERE

# ── Email (SendGrid) ─────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxx
EMAIL_FROM=msapo@yourdomain.com

# ── Optional ─────────────────────────────────────────────────────────
# Anthropic model override (default: claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# PDF conversion backend: libreoffice | gotenberg | docx2pdf
PDF_BACKEND=libreoffice

# Gotenberg URL (only needed if PDF_BACKEND=gotenberg)
# GOTENBERG_URL=http://localhost:3000

# Webhook authentication token (optional, query param ?token=...)
# WEBHOOK_SECRET=my-secret-token
