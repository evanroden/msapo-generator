# ── Required ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-YOUR-KEY-HERE
EPC_ACCESS_PASSWORD=use-a-long-random-internal-password

# ── Email (SendGrid; legacy path pending removal) ─────────────────────
SENDGRID_API_KEY=SG.xxxxx
EMAIL_FROM=msapo@yourdomain.com

# ── Optional ─────────────────────────────────────────────────────────
# Anthropic model override (default: claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# PDF conversion backend: libreoffice | gotenberg | docx2pdf
PDF_BACKEND=libreoffice

# Gotenberg URL (only needed if PDF_BACKEND=gotenberg)
# GOTENBERG_URL=http://localhost:3000

# Webhook authentication token (legacy path pending removal)
# WEBHOOK_SECRET=my-secret-token
