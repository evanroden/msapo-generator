+def _requirements_year(draft, block, matrix, stored, directory, key, prefix):
+    """One explicit transition, after consuming pending edits in the old grid."""
+    from app.monthly_report_guided import _rich_text_scope
+    year = draft.period.year
+    request_key = prefix + "_training_year_request"
+    scope = _signature((draft.profile, draft.period, _rich_text_scope(prefix), block.source, draft.prepared_by, draft.synthetic))
+    expected = {"scope": scope, "matrix": _signature(matrix),
+                "revision": stored["revision"], "year": year}
+    request = st.session_state.pop(request_key, None)
+    changed = False
+    if request is not None and not isinstance(request, dict):
+        st.warning("The training year action is no longer valid. Review the matrix and try again.")
+        request = None
+    if request is not None:
+        canonical = next((t for t in block.extra_tables if is_matrix_reference(t.reference)), None)
+        report_changed = canonical is not None and _signature(canonical) != request.get("matrix")
+        if request != expected or report_changed or st.session_state.get(key + "_stale_standing"):
+            st.warning("The training matrix changed. Your edits are kept; review it before starting another year.")
+            if report_changed and request.get("scope") == scope and block.source != "Omit":
+                # An external report correction must not remain hidden behind
+                # this editor's older matrix buffer after the stale action.
+                matrix, changed = hospital_matrix(draft.profile, canonical, directory), True
+        elif matrix_year(matrix.reference) != year and block.source != "Omit" and not draft.synthetic:
+            proposed = matrix_for_year(draft.profile, matrix, stored, year, directory)
+            stored = save_training(draft.profile, proposed, expected_revision=stored["revision"], actor=draft.prepared_by)
+            matrix, changed = proposed, True
+            st.success(f"Requirements for {year} are ready. Earlier years and monthly sessions are unchanged.")
+    st.caption(matrix_title(matrix.reference))
+    if matrix_year(matrix.reference) != year:
+        st.caption(f"Starting {year} reuses saved {year} values where available; other sites keep their roster and requirements with statuses reset. Blank cells stay blank.")
+        st.button(f"Start {year} requirements", key=key + "_start_year_" + _signature(expected),
+                  on_click=_queue_matrix_year, args=(request_key, expected),
+                  disabled=draft.synthetic or block.source == "Omit" or bool(st.session_state.get(key + "_stale_standing")))
+    return matrix, stored, changed
+
